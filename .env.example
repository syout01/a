# サーバーのポート（省略時 3000）
PORT=3000
# SQLite ファイルの置き場所（省略時 data/app.db）
DB_PATH=data/app.db
# バックアップの置き場所と保持世代（省略時 data/backups、14 世代）
# BACKUP_DIR=data/backups
# BACKUP_KEEP=14
# 招待リンクに使う外部 URL（省略時はアクセスされたホスト名から組み立てる）
# APP_URL=https://leads.example.co.jp
# リバースプロキシ配下でない場合は 0（既定は 1 = X-Forwarded-* を信用）
# TRUST_PROXY=1

# Google スプレッドシートへ直接書き出す場合のみ設定（どちらか一方）
# サービスアカウントの JSON キーファイルのパス
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# もしくは JSON の中身をそのまま
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- LP（公開ページ）と広告計測 ---
# Google タグマネージャーのコンテナ ID。設定すると /lp.html と /lp-thanks.html に自動で差し込まれる
# GTM_ID=GTM-XXXXXXX
# LP の相談フォームが送信されたら Slack に通知する Incoming Webhook の URL
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
